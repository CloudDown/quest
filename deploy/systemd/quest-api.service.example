[Unit]
Description=Quest API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/quest/server
Environment=QUEST_DATABASE_URL=sqlite:////var/lib/quest/quest.db
Environment=QUEST_UPLOAD_DIR=/var/lib/quest/uploads
Environment=QUEST_DEMO_MODE=1
Environment=QUEST_CORS_ORIGINS=*
ExecStart=/home/pi/quest/server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
